{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kerr",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "kerr.cloakyard.com",
      "custom_domain": true,
    },
  ],
}
