.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.history/
*.code-workspace

# JetBrains
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
Sessionx.vim
.netrwhist
tags

# Emacs
*#
\#*\#
.\#*
.projectile

# Sublime
*.sublime-workspace
*.sublime-project

# Zed
.zed/


# ---------------------------------------------------------------------------
# AI assistant local state — keep shared config, ignore session data
