# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo


# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
bower_components/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Lockfiles for package managers this project does not use. package-lock.json
# is committed on purpose — it pins the wrangler toolchain.
pnpm-lock.yaml
yarn.lock
bun.lockb


# ---------------------------------------------------------------------------
# Cloudflare / Wrangler
# ---------------------------------------------------------------------------
.wrangler/
.dev.vars
.dev.vars.*
.mf/
wrangler.toml.bak


# ---------------------------------------------------------------------------
# Environment & secrets — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.netrc
secrets.json


# ---------------------------------------------------------------------------
# Logs & diagnostics
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.heapsnapshot
*.cpuprofile
core
core.*


# ---------------------------------------------------------------------------
# Caches
# ---------------------------------------------------------------------------
.cache/
.temp/
.tmp/
tmp/
.npm/
.eslintcache
.stylelintcache
.parcel-cache/
.vite/
.turbo/


# ---------------------------------------------------------------------------
# Test & tooling artefacts
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright-mcp/
.lighthouseci/


# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.fseventsd
.DocumentRevisions-V100
.apdisk
# The Finder custom-icon file is literally "Icon" plus a carriage return.
# Written as `Icon?` the ? is a glob wildcard, and it quietly swallowed
# public/icons/ — every PWA icon was being left out of commits. The bracket
# form matches the CR and nothing else.
Icon[$'\r']

# Written by macOS onto external / network volumes
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items


# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk
*.cab
*.msi
*.msix
*.msm
*.msp


# ---------------------------------------------------------------------------
# Linux
# ---------------------------------------------------------------------------
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ---------------------------------------------------------------------------
# Editors & IDEs
# ---------------------------------------------------------------------------
